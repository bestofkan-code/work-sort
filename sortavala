let manualEdges=null,edgeFrom=null;
const pid=p=>String(p.r['Описание']||'').trim()||`${p.r[hl]},${p.r[hn]}`;
function manualGroups(list){
  const byId=new Map(poles.map(p=>[pid(p),p])),inList=new Set(list),g={};
  list.forEach(p=>{const k=sipKey(p);if(k)(g[k]=g[k]||{key:k,name:String(p.r['Тип метки']).trim().replace(/\s+/g,' '),color:sipHue[k],poles:[],edges:[],len:0}).poles.push(p)});
  manualEdges.forEach(([x,y])=>{
    const a=byId.get(x),b=byId.get(y);if(!a||!b||!inList.has(a)||!inList.has(b))return;
    const k=sipKey(a);if(!g[k])return;const d=pd(a,b);g[k].edges.push([a,b,d]);g[k].len+=d;
  });
  return Object.keys(g).sort().map(k=>g[k]);
}
function freezeSip(){
  if(manualEdges)return;
  const data=computeSip(poles);manualEdges=[];
  data.forEach(g=>g.edges.forEach(([a,b])=>manualEdges.push([pid(a),pid(b)])));sipSheet=true;
}
const samePair=(e,x,y)=>(e[0]===x&&e[1]===y)||(e[0]===y&&e[1]===x);
function addEdge(a,b){
  freezeSip();const x=pid(a),y=pid(b);
  if(!manualEdges.some(e=>samePair(e,x,y)))manualEdges.push([x,y]);
  save();draw(false);
}
function removeEdge(a,b){
  freezeSip();const x=pid(a),y=pid(b);
  manualEdges=manualEdges.filter(e=>!samePair(e,x,y));save();draw(false);
}
function remapEdge(o,n){if(manualEdges&&o!==n)manualEdges=manualEdges.map(e=>e.map(v=>v===o?n:v))}
function dropEdges(id){if(manualEdges)manualEdges=manualEdges.filter(e=>!e.includes(id))}

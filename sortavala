  const th=a=>'<tr>'+a.map(x=>`<th>${esc(x)}</th>`).join('')+'</tr>',td=a=>'<tr>'+a.map(x=>`<td>${esc(x)}</td>`).join('')+'</tr>';
  $('repBody').innerHTML=`<h2>Отчёт о выполненных работах</h2><p>Объект: опоры освещения, Сортавала, этап 1<br>Период: ${perText()}<br>Сформирован: ${fmtDate(today())}</p>
  <h3>Сводка по этапам</h3><table>${th(['Этап','За период','Всего выполнено','Всего опор','%'])}${d.sum.map(x=>td([x.s.name,x.per,x.tot,d.n,d.n?Math.round(x.tot*100/d.n)+'%':''])).join('')}</table>
  <h3>По ТП (выполнено на конец периода / опор)</h3><table>${th(['ТП','Опор',...STAGES.map(s=>s.name)])}${d.tp.map(g=>td([g.name,g.n,...g.c.map(c=>c+' / '+g.n)])).join('')}</table>
  <h3>Журнал работ (${d.log.length})</h3><table>${th(['Дата','Опора','ТП','Работа','Описание'])}${d.log.map(r=>td([fmtDate(r.d),r.pole,r.tp,r.stage,r.desc])).join('')}</table>`;
  return d;
}
function putReport(){
  const d=renderReport();
  const aoa=[['Отчёт о выполненных работах'],['Период',perText()],['Сформирован',fmtDate(today())],[],
    ['Сводка по этапам'],['Этап','За период','Всего выполнено','Всего опор','%'],
    ...d.sum.map(x=>[x.s.name,x.per,x.tot,d.n,d.n?Math.round(x.tot*100/d.n)/100:'']),[],
    ['По ТП (выполнено на конец периода)'],['ТП','Опор',...STAGES.map(s=>s.name)],
    ...d.tp.map(g=>[g.name,g.n,...g.c]),[],
    ['Журнал работ'],['Дата','Опора','ТП','Работа','Описание'],
    ...d.log.map(r=>[fmtDate(r.d),r.pole,r.tp,r.stage,r.desc])];
  const ws=XLSX.utils.aoa_to_sheet(aoa);ws['!cols']=[{wch:28},{wch:16},{wch:18},{wch:22},{wch:50}];
  const nm='Отчёт о работах';
  if(wb.SheetNames.includes(nm))wb.Sheets[nm]=ws;else XLSX.utils.book_append_sheet(wb,ws,nm);
}
$('bRep').onclick=()=>{renderReport();$('report').hidden=false};
$('repFrom').onchange=$('repTo').onchange=renderReport;
$('repClose').onclick=()=>$('report').hidden=true;
$('repPrint').onclick=()=>window.print();
$('repXls').onclick=()=>{putReport();save();status('Отчёт записан на лист «Отчёт о работах»','ok')};

// ---------- резервная копия правок (iOS выгружает вкладки из памяти) ----------
function backup(){try{localStorage.setItem('opory_backup',JSON.stringify({t:Date.now(),f:fileName,s:snap()}))}catch(e){}}
function clearBackup(){try{localStorage.removeItem('opory_backup')}catch(e){}}
function checkBackup(){
  if(handle)return;
  try{
    const b=JSON.parse(localStorage.getItem('opory_backup')||'null');
    if(!b||b.f!==fileName||b.s===snap())return;
    if(confirm('Найдены несохранённые правки от '+new Date(b.t).toLocaleString('ru')+'. Восстановить?')){restore(b.s);pushHist()}else clearBackup();
  }catch(e){}
}
</script>

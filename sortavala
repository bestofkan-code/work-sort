<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Карта опор освещения — редактор</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
<style>
*{box-sizing:border-box}
body{margin:0;font:14px system-ui,sans-serif;display:flex;flex-direction:column;height:100vh}
header{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:8px 12px;background:#1f2937;color:#fff}
header input,header select,header button{padding:6px 8px;border-radius:6px;border:0;font-size:14px}
button,.btn{background:#f59e0b;color:#111;cursor:pointer;font-weight:600;border:0;border-radius:6px;padding:6px 10px}
button:disabled{opacity:.4;cursor:default}
#map{flex:1}
#status{margin-left:auto;font-weight:600}
.ok{color:#86efac}.err{color:#fca5a5}.warn{color:#fde68a}
#hint{position:absolute;z-index:999;top:64px;left:50%;transform:translateX(-50%);background:#111c;color:#fff;padding:8px 16px;border-radius:8px}
#msg{position:absolute;z-index:999;top:70px;left:50%;transform:translateX(-50%);background:#fff;padding:18px 26px;border-radius:10px;box-shadow:0 4px 20px #0005;text-align:center;max-width:90%}
.pop table{border-collapse:collapse;margin:6px 0}
.pop td{padding:2px 8px 2px 0;vertical-align:middle}.pop td:first-child{color:#666}
.pop input{width:100%;padding:3px 5px;border:1px solid #bbb;border-radius:4px}
.row{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
.row a,.row button{padding:5px 9px;font-size:13px}
.row a{border-radius:6px;background:#2563eb;color:#fff!important;text-decoration:none}
.gray{background:#e5e7eb!important}.red{background:#fca5a5!important}
#legend{position:absolute;z-index:999;bottom:20px;left:10px;background:#fffd;padding:6px 10px;border-radius:8px;max-height:40vh;overflow:auto;font-size:12px}
#legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}
.crosshair{cursor:crosshair!important}

.note{display:inline-block;white-space:nowrap;background:#fffe;border:2px solid;border-radius:8px;padding:3px 8px;font-weight:600;font-size:14px;box-shadow:0 1px 4px #0004}
.ltip{background:#fffe;border:1px solid #999;font-weight:600}
@media(pointer:coarse){button,header select,header input{padding:10px 14px;font-size:16px}.pop input{padding:8px;font-size:16px}.row button,.row a{padding:10px 14px;font-size:15px}}
#sip{position:absolute;z-index:999;right:10px;bottom:30px;background:#fffe;padding:8px 12px;border-radius:8px;max-height:50vh;overflow:auto;font-size:13px;max-width:290px}
#sip i{display:inline-block;width:12px;height:12px;border-radius:50%;margin-right:6px}
.sip-len{background:#fffe;border:1px solid #333;padding:0 4px;font:600 11px system-ui;color:#111;box-shadow:none}
.sip-len:before{display:none}
.hide-len .sip-len{display:none}
#report{position:fixed;top:0;left:0;right:0;bottom:0;z-index:2000;background:#fff;overflow:auto;padding:16px 24px}
#report[hidden]{display:none}
#report table{border-collapse:collapse;margin:6px 0 16px;font-size:13px}
#report th,#report td{border:1px solid #999;padding:3px 8px;text-align:left}
#report th{background:#e5e7eb}
#report .bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
@media print{body>*:not(#report){display:none!important}body{display:block;height:auto}#report{position:static!important;overflow:visible!important;padding:0}.noprint{display:none!important}}
html{-webkit-text-size-adjust:100%}
body{height:100dvh;overscroll-behavior:none;-webkit-tap-highlight-color:transparent}
#map{min-height:0;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
button,select,label{touch-action:manipulation}
header{padding-left:max(12px,env(safe-area-inset-left));padding-right:max(12px,env(safe-area-inset-right));padding-top:max(8px,env(safe-area-inset-top))}
@media(max-width:900px){
 header{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch}
 header>*{flex:none}
 input,select{font-size:16px!important}
 #legend{max-width:46vw;max-height:28vh;font-size:11px;bottom:calc(16px + env(safe-area-inset-bottom,0px))}
 #sip{max-width:52vw;max-height:30vh;bottom:calc(26px + env(safe-area-inset-bottom,0px))}
 #hint{width:90vw;font-size:13px}
 #report{padding:12px}
}
</style>
</head>
<body>
<header>
  <button id="open">📂 Открыть Excel</button>
  <button id="bUndo" disabled>↩ Отменить</button>
  <button id="bRedo" disabled>↪ Вернуть</button>
  <button id="bNear" disabled>📍 Ближайшая опора</button>
  <button id="bMark" disabled>✅ Отметка работ</button>
  <span id="markBox" hidden><select id="stageSel"></select> <input type="date" id="markDate"></span>
  <button id="bRep" disabled>📄 Отчёт</button>
  <input id="q" placeholder="Поиск…" size="18">
  <select id="colorBy"><option value="">Цвет: один</option></select>
  <button id="add" disabled>➕ Опора</button>
  <button id="bNote" disabled>📌 Пометка</button>
  <button id="bLine" disabled>〰 Линия</button>
  <button id="bFree" disabled>🖊 От руки</button>
  <select id="pen"><option value="#e11d48">🔴 Красный</option><option value="#2563eb">🔵 Синий</option><option value="#16a34a">🟢 Зелёный</option><option value="#f59e0b">🟠 Оранжевый</option><option value="#111827">⚫ Чёрный</option><option value="#9333ea">🟣 Фиолетовый</option></select>
  <button id="bSip" disabled>⚡ Схема СИП</button>
  <span id="spanBox" hidden>макс. пролёт <input id="span" type="number" value="100" min="20" step="10" style="width:70px"> м · <label><input type="checkbox" id="lenLbl" checked> подписи</label> <button id="bEdge">🔗 Связь</button> <button id="bAuto" class="gray" hidden>↺ К авто</button></span>
  <button id="dl" hidden>⬇ Скачать Excel</button>
  <span id="info"></span>
  <span id="status"></span>
</header>
<div id="map"></div>
<div id="hint" hidden></div>
<div id="msg">Нажмите <b>«Открыть Excel»</b> и выберите файл с опорами.<br>Правки на карте будут сразу сохраняться в этот же файл.<br><small>Нужен Chrome или Edge на компьютере. Закройте файл в самом Excel.</small></div>
<div id="legend" hidden></div>
<div id="sip" hidden></div>
<div id="report" hidden>
  <div class="bar noprint"><b>Отчёт о работах</b> с <input type="date" id="repFrom"> по <input type="date" id="repTo">
    <button id="repXls">📋 В Excel</button><button id="repPrint" class="gray">🖨 Печать / PDF</button><button id="repClose" class="gray">✕ Закрыть</button></div>
  <div id="repBody"></div>
</div>
<input id="file" type="file" accept=".xlsx,.xls,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" hidden>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
if(!Element.prototype.replaceChildren)Element.prototype.replaceChildren=function(){this.textContent='';this.append.apply(this,arguments)};
const $=id=>document.getElementById(id);
const map=L.map('map',{preferCanvas:true}).setView([61.70,30.69],13);
L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap'}).addTo(map);
const group=L.layerGroup().addTo(map);
const PAL=['#e6194b','#3cb44b','#4363d8','#f58231','#911eb4','#42d4f4','#f032e6','#bfef45','#9a6324','#800000','#469990','#808000'];
let wb,sheetName,handle=null,hdr=[],hl,hn,poles=[],mode=null,target=null,timer=null,dirty=false,hist=[],redo=[],fileName='';
const num=v=>{const n=parseFloat(String(v).replace(',','.'));return isNaN(n)?null:n};
const find=(keys)=>hdr.find(h=>keys.includes(String(h).trim().toLowerCase()));
function status(t,c){$('status').textContent=t;$('status').className=c||''}

// ---------- открытие ----------
$('open').onclick=async()=>{
  if(window.showOpenFilePicker){
    try{
      const [h]=await showOpenFilePicker({types:[{description:'Excel',accept:{'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet':['.xlsx']}}]});
      if(await h.requestPermission({mode:'readwrite'})!=='granted'){status('Нет разрешения на запись','err');return}
      handle=h;load(await (await h.getFile()).arrayBuffer());
    }catch(e){if(e.name!=='AbortError')status('Ошибка: '+e.message,'err')}
  }else $('file').click();
};
$('file').onchange=async e=>{handle=null;fileName=e.target.files[0].name;load(await e.target.files[0].arrayBuffer());
  status('Автосохранение недоступно в этом браузере — используйте «Скачать Excel»','warn');$('dl').hidden=false};

function load(buf){
  wb=XLSX.read(buf,{type:'array'});sheetName=wb.SheetNames[0];
  const ws=wb.Sheets[sheetName];
  hdr=XLSX.utils.sheet_to_json(ws,{header:1,defval:''})[0].map(String);
  hl=find(['lat','latitude','широта']);hn=find(['lon','lng','longitude','долгота']);
  if(!hl||!hn){alert('Нужны столбцы «Широта» и «Долгота»');return}
  poles=XLSX.utils.sheet_to_json(ws,{defval:''}).map(r=>({r})).filter(p=>num(p.r[hl])!=null&&num(p.r[hn])!=null);
  poles.forEach(p=>{p.r[hl]=num(p.r[hl]);p.r[hn]=num(p.r[hn])});
  WCOLS.forEach(c=>{if(!hdr.includes(c))hdr.push(c)});poles.forEach(p=>WCOLS.forEach(c=>{if(p.r[c]===undefined)p.r[c]=''}));
  const keep=['Тип метки','Название'].filter(c=>hdr.includes(c));
  $('colorBy').innerHTML='<option value="">Цвет: один</option><option value="@stage">Этап работ</option>'+hdr.filter(c=>c!==hl&&c!==hn&&!isWorkCol(c)).map(c=>`<option>${c}</option>`).join('');
  if(keep.length)$('colorBy').value=keep[0];
  annots=[];sipSheet=wb.SheetNames.includes('Схема СИП');manualEdges=null;
  if(sipSheet){const rr=XLSX.utils.sheet_to_json(wb.Sheets['Схема СИП'],{defval:''}).map(r=>[String(r['От опоры']).trim(),String(r['До опоры']).trim()]).filter(e=>e[0]&&e[1]);if(rr.length)manualEdges=rr}
  if(wb.SheetNames.includes('Пометки'))annots=XLSX.utils.sheet_to_json(wb.Sheets['Пометки'],{defval:''}).map(r=>({type:r['Тип']==='пометка'?'note':'line',color:r['Цвет']||'#e11d48',text:String(r['Текст']),pts:String(r['Координаты']).split(';').map(s=>s.split(',').map(Number)).filter(p=>p.length===2&&!p.some(isNaN))})).filter(a=>a.pts.length);
  $('msg').hidden=true;['add','bNote','bLine','bFree','bSip','bNear','bMark','bRep'].forEach(i=>$(i).disabled=false);
  draw(true);renderAnnots();hist=[snap()];redo=[];updUndo();checkBackup();
  if(handle)status('✓ Файл открыт, правки сохраняются автоматически','ok');
}

// ---------- сохранение ----------
function save(noHist){if(noHist!==true)pushHist();if(!handle)backup();clearTimeout(timer);status('Сохранение…','warn');timer=setTimeout(doSave,400)}
async function doSave(){
  try{
    const ws=XLSX.utils.json_to_sheet(poles.map(p=>p.r),{header:hdr});
    ws['!cols']=hdr.map(()=>({wch:22}));
    wb.Sheets[sheetName]=ws;putAnnots();
    const out=XLSX.write(wb,{type:'array',bookType:'xlsx'});
    if(handle){
      const w=await handle.createWritable();await w.write(out);await w.close();
      status('✓ Сохранено '+new Date().toLocaleTimeString(),'ok');dirty=false;
    }else{dirty=true;status('Есть несохранённые правки — нажмите «Скачать Excel»','warn')}
  }catch(e){status('Не сохранено: '+e.message+' (закройте файл в Excel)','err')}
}
$('dl').onclick=async()=>{
  const ws=XLSX.utils.json_to_sheet(poles.map(p=>p.r),{header:hdr});ws['!cols']=hdr.map(()=>({wch:22}));
  wb.Sheets[sheetName]=ws;putAnnots();
  const name=fileName||'опоры_освещения.xlsx';
  try{
    const out=XLSX.write(wb,{type:'array',bookType:'xlsx'});
    const f=new File([out],name,{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f],title:name});dirty=false;clearBackup();return}
  }catch(e){if(e&&e.name==='AbortError')return}
  XLSX.writeFile(wb,name);dirty=false;clearBackup();
};

// ---------- отрисовка ----------
const isAnchor=p=>/анкер/i.test(String(p.r['Название']||''));
function poleIcon(p,color){
  const an=isAnchor(p),s=Math.round((COARSE?1.4:1)*(an?17:15));
  const st=an?`width:${s}px;height:${s}px;background:${color};border:3px solid #111;box-sizing:border-box`
    :`width:${s}px;height:${s}px;background:${color};border:2px solid #fff;border-radius:50%;box-sizing:border-box;box-shadow:0 0 0 1px #333`;
  return L.divIcon({className:'',html:`<div style="${st}"></div>`,iconSize:[s,s],iconAnchor:[s/2,s/2],popupAnchor:[0,-s/2]});
}
function tpColors(){[...new Set(poles.map(sipKey).filter(Boolean))].sort().forEach((k,i)=>sipHue[k]=`hsl(${(i*137.5)%360},70%,42%)`)}
function draw(fit){
  group.clearLayers();tpColors();
  const q=$('q').value.trim().toLowerCase(),by=$('colorBy').value,byTp=by==='Тип метки'||sipOn;
  const vals=by?[...new Set(poles.map(p=>String(p.r[by])))]:[];
  const col=v=>PAL[vals.indexOf(String(v))%PAL.length];
  const shown=poles.filter(p=>!q||Object.values(p.r).some(v=>String(v).toLowerCase().includes(q)));
  shown.forEach(p=>{
    const c=byTp?sipColor(p):(by==='@stage'?stageColor(p):(by?col(p.r[by]):'#f59e0b'));
    p.m=L.marker([p.r[hl],p.r[hn]],{icon:poleIcon(p,c),keyboard:false})
      .bindPopup(()=>popupEl(p,false),{maxWidth:340,maxHeight:Math.round(innerHeight*0.7)}).addTo(group);
    p.m.on('click',e=>{if(mode){L.DomEvent.stopPropagation(e);mapClick(e.latlng,p)}});
  });
  $('info').textContent=`Опор: ${shown.length} из ${poles.length}`;renderSip(shown);
  const na=shown.filter(isAnchor).length;
  const shapes=`<div style="margin-top:6px"><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#999;border:2px solid #fff;box-shadow:0 0 0 1px #333;margin-right:6px"></span>Стандартная (${shown.length-na})</div><div><span style="display:inline-block;width:13px;height:13px;background:#999;border:3px solid #111;box-sizing:border-box;margin-right:6px"></span>Анкерная (${na})</div>`;
  let colors='';
  if(by==='Тип метки'&&!sipOn){
    const m={};shown.forEach(p=>{const k=sipKey(p);if(k)(m[k]=m[k]||{n:String(p.r[by]).trim().replace(/\s+/g,' '),c:0}).c++});
    colors='<b>ТП</b>'+Object.keys(m).sort().map(k=>`<div><i style="background:${sipHue[k]}"></i>${esc(m[k].n)} (${m[k].c})</div>`).join('');
  }else if(by==='@stage'&&!sipOn){colors=stageLegend(shown)}else if(by&&!sipOn)colors=`<b>${esc(by)}</b>`+vals.slice(0,40).map(v=>`<div><i style="background:${col(v)}"></i>${esc(v)||'—'}</div>`).join('');
  const lg=$('legend');lg.hidden=false;lg.innerHTML=colors+shapes;
  if((fit||q)&&shown.length)map.fitBounds(L.latLngBounds(shown.map(p=>[p.r[hl],p.r[hn]])),{padding:[40,40],maxZoom:18});
}
$('q').oninput=()=>draw(false);$('colorBy').onchange=()=>draw(false);

// ---------- карточка ----------
function el(tag,props={},kids=[]){const e=Object.assign(document.createElement(tag),props);kids.forEach(k=>e.append(k));return e}
function popupEl(p,edit){
  const root=el('div',{className:'pop'});
  if(!edit&&p===nearP)root.append(el('div',{textContent:'📍 Ближайшая опора: '+Math.round(nearD)+' м от вас',style:'font-weight:600'}));
  const t=el('table');const inputs={};
  hdr.forEach(c=>{
    if(isWorkCol(c))return;
    const v=p.r[c];
    if(edit){const i=el('input',{value:v});inputs[c]=i;t.append(el('tr',{},[el('td',{textContent:c}),el('td',{},[i])]))}
    else if(String(v).trim()!==''&&c!==hl&&c!==hn)t.append(el('tr',{},[el('td',{textContent:c}),el('td',{textContent:v})]));
  });
  root.append(t);
  if(!edit)root.append(stageLine(p));
  const row=el('div',{className:'row'});
  if(edit){
    row.append(el('button',{textContent:'💾 Сохранить',onclick:()=>{
      const oldId=pid(p);
      hdr.forEach(c=>{if(!inputs[c])return;let v=inputs[c].value;if(c===hl||c===hn){const n=num(v);if(n==null)return;v=n}p.r[c]=v});
      remapEdge(oldId,pid(p));
      p.m.setLatLng([p.r[hl],p.r[hn]]);save();draw(false);
    }}),el('button',{className:'gray',textContent:'Отмена',onclick:()=>p.m.setPopupContent(popupEl(p,false))}));
  }else{
    const la=p.r[hl],lo=p.r[hn];
    row.append(
      el('button',{textContent:'🏗 Работы',onclick:()=>p.m.setPopupContent(workEl(p))}),
      el('button',{textContent:'✏️ Изменить',onclick:()=>p.m.setPopupContent(popupEl(p,true))}),
      el('button',{className:'gray',textContent:'📍 Переместить',onclick:()=>{target=p;setMode('move','Кликните по карте — новое положение опоры')}}),
      el('button',{className:'red',textContent:'🗑 Удалить',onclick:()=>{if(confirm('Удалить опору?')){poles=poles.filter(x=>x!==p);dropEdges(pid(p));save();draw(false)}}}));
    const nav=el('div',{className:'row'});
    [['Яндекс',`https://yandex.ru/maps/?rtext=~${la},${lo}&rtt=auto`],['Google',`https://www.google.com/maps/dir/?api=1&destination=${la},${lo}`],['2ГИС',`https://2gis.ru/routeSearch/rsType/car/to/${lo},${la}`]]
      .forEach(([n,h])=>nav.append(el('a',{textContent:n,href:h,target:'_blank'})));
    root.append(row,nav);return root;
  }
  root.append(row);return root;
}

// ---------- режимы карты ----------
const cont=map.getContainer();
const COARSE=matchMedia('(pointer:coarse)').matches;
const COLORS=['#e11d48','#2563eb','#16a34a','#f59e0b','#111827','#9333ea'];
const annotGroup=L.layerGroup().addTo(map),tmpLayer=L.layerGroup().addTo(map);
let annots=[],drawColor=COLORS[0],tmpPts=[],fpts=null;
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const btn=(t,f)=>el('button',{textContent:t,onclick:f,style:'margin-left:8px'});
const len=pts=>pts.reduce((s,p,i)=>i?s+L.latLng(pts[i-1]).distanceTo(L.latLng(p)):0,0);
const fmt=m=>m<1000?Math.round(m)+' м':(m/1000).toFixed(2)+' км';

function setMode(m,text){
  if(mode==='line'||mode==='free'||mode==='edge'){tmpLayer.clearLayers();tmpPts=[];fpts=null;edgeFrom=null}
  mode=m;const hb=$('hint');hb.hidden=!m;hb.replaceChildren(text||'');
  if(m==='line')hb.append(btn('↩ Точка',()=>{tmpPts.pop();updateTmp()}),btn('✓ Готово',finishLine));
  if(m)hb.append(btn('✕',()=>setMode(null)));
  cont.classList.toggle('crosshair',!!m&&m!=='free');
  const f=m==='free';
  ['dragging','touchZoom','doubleClickZoom'].forEach(k=>map[k][f?'disable':'enable']());
  cont.style.touchAction=f?'none':'';
  $('markBox').hidden=m!=='mark';
  map.closePopup();
}
map.on('popupopen',()=>{if(mode)map.closePopup()});
$('add').onclick=()=>setMode('add','Коснитесь карты, где стоит новая опора');
$('bNote').onclick=()=>setMode('note','Коснитесь места для пометки');
$('bLine').onclick=()=>setMode('line','Ставьте точки касанием (можно на опорах), затем «Готово»');
$('bFree').onclick=()=>setMode('free','Рисуйте пальцем или стилусом');
$('pen').onchange=e=>drawColor=e.target.value;
document.addEventListener('keydown',e=>{if(e.key==='Escape')setMode(null)});
window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue=''}});

function mapClick(ll,pole){
  if(!mode)return;
  if(mode==='edge'){edgeClick(pole);return}
  if(mode==='mark'){markClick(pole);return}
  const {lat,lng}=ll;
  if(mode==='move'){const oldId=pid(target);target.r[hl]=+lat.toFixed(6);target.r[hn]=+lng.toFixed(6);remapEdge(oldId,pid(target));save();setMode(null);draw(false);target.m.openPopup()}
  else if(mode==='add'){
    const r={};hdr.forEach(c=>r[c]='');r[hl]=+lat.toFixed(6);r[hn]=+lng.toFixed(6);
    if(hdr.includes('Название'))r['Название']='Стандартная';
    const p={r};poles.push(p);setMode(null);draw(false);

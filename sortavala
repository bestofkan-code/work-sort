// отчёт
function repData(from,to){
  const up=d=>d&&(!to||d<=to),inP=d=>d&&(!from||d>=from)&&(!to||d<=to);
  const sum=STAGES.map(s=>({s,per:poles.filter(p=>inP(stageDate(p,s))).length,tot:poles.filter(p=>up(stageDate(p,s))).length}));
  const g={};
  poles.forEach(p=>{
    const k=sipKey(p)||'—',o=g[k]=g[k]||{name:String(p.r['Тип метки']||'—').trim().replace(/\s+/g,' '),n:0,c:STAGES.map(()=>0)};
    o.n++;STAGES.forEach((s,i)=>{if(up(stageDate(p,s)))o.c[i]++});
  });
  const log=[];
  poles.forEach(p=>STAGES.forEach(s=>{const d=stageDate(p,s);if(inP(d))log.push({d,pole:pn(p),tp:String(p.r['Тип метки']||'').trim(),stage:s.name,desc:String(p.r[oc(s)]||'')})}));
  log.sort((a,b)=>a.d.localeCompare(b.d)||a.pole.localeCompare(b.pole,'ru',{numeric:true}));
  return {n:poles.length,sum,tp:Object.keys(g).sort().map(k=>g[k]),log};
}
const perText=()=>{const f=$('repFrom').value,t=$('repTo').value;return f||t?`${fmtDate(f)||'…'} — ${fmtDate(t)||'…'}`:'за всё время'};
function renderReport(){

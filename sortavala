let sipOn=false,sipSheet=false,sipList=[];const sipHidden=new Set(),sipHue={};
const sipLayer=L.layerGroup().addTo(map);
const sipKey=p=>String(p.r['Тип метки']==null?'':p.r['Тип метки']).toLowerCase().replace(/\s+/g,'');
const sipColor=p=>sipHue[sipKey(p)]||'#888';
const pd=(a,b)=>L.latLng(a.r[hl],a.r[hn]).distanceTo([b.r[hl],b.r[hn]]);
const pn=p=>String(p.r['Описание']||'?');
function computeSip(list){
  const max=+$('span').value||100,g={};
  [...new Set(poles.map(sipKey).filter(Boolean))].sort().forEach((k,i)=>sipHue[k]=`hsl(${(i*137.5)%360},70%,42%)`);
  if(manualEdges)return manualGroups(list);
  list.forEach(p=>{const k=sipKey(p);if(k)(g[k]=g[k]||[]).push(p)});
  return Object.keys(g).sort().map(k=>{
    const P=g[k],n=P.length,edges=[],inT=Array(n).fill(false),best=Array(n).fill(Infinity),from=Array(n).fill(-1);
    best[0]=0;
    for(let s=0;s<n;s++){
      let u=-1;for(let j=0;j<n;j++)if(!inT[j]&&(u<0||best[j]<best[u]))u=j;
      inT[u]=true;
      if(from[u]>=0&&best[u]<=max)edges.push([P[from[u]],P[u],best[u]]);
      for(let j=0;j<n;j++)if(!inT[j]){const d=pd(P[u],P[j]);if(d<best[j]){best[j]=d;from[j]=u}}
    }
    return {key:k,name:String(P[0].r['Тип метки']).trim().replace(/\s+/g,' '),color:sipHue[k],poles:P,edges,len:edges.reduce((s,e)=>s+e[2],0)};
  });
}
function renderSip(list){
  sipLayer.clearLayers();const panel=$('sip');
  if(!sipOn){panel.hidden=true;return}
  sipList=list;$('bAuto').hidden=!manualEdges;const data=computeSip(list);
  data.forEach(g=>{
    if(sipHidden.has(g.key))return;
    g.edges.forEach(([a,b,d])=>L.polyline([[a.r[hl],a.r[hn]],[b.r[hl],b.r[hn]]],{color:g.color,weight:COARSE?5:3,opacity:.9})
      .bindTooltip(Math.round(d)+' м',{permanent:true,direction:'top',offset:[0,-2],className:'sip-len'})
      .bindPopup(()=>edgePopup(a,b,d,g)).addTo(sipLayer));
  });
  group.eachLayer(l=>l.bringToFront&&l.bringToFront());updLbl();
  const total=data.reduce((s,g)=>s+g.len,0);
  panel.hidden=false;
  panel.replaceChildren(el('b',{textContent:`Схема СИП${manualEdges?' (вручную)':''}: ${data.length} ТП, ${fmt(total)}`}),
    ...data.map(g=>el('div',{style:`cursor:pointer;padding:4px 0;opacity:${sipHidden.has(g.key)?.35:1}`,
      onclick:()=>{sipHidden.has(g.key)?sipHidden.delete(g.key):sipHidden.add(g.key);renderSip(sipList)}},
      [el('i',{style:`background:${g.color}`}),`${g.name} — ${g.poles.length} оп., ${fmt(g.len)}`])),
    el('div',{className:'row'},[
      el('button',{className:'gray',textContent:'Показать все',onclick:()=>{sipHidden.clear();renderSip(sipList)}}),
      el('button',{textContent:'📋 В Excel',onclick:()=>{sipSheet=true;save()}})]));
}
